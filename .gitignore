# =========================================================================
# 1. FRONTEND FILES (React, Vite, Next.js)
# =========================================================================
# Dependencies
frontend/node_modules/
frontend/.pnpm-store/

# Production Build Output
frontend/dist/
frontend/build/

# Local Environment & Secrets (NEVER COMMIT SENSITIVE STRINGS)
frontend/.env
frontend/.env.local
frontend/.env.*.local

# Framework Caches
frontend/.vite/
frontend/.next/


# =========================================================================
# 2. BACKEND FILES (Node.js, Express, NestJS, Databases)
# =========================================================================
# Dependencies
backend/node_modules/

# Production Compiled Output
backend/dist/
backend/build/

# Local Secrets & Variables
backend/.env
backend/.env.local

# Databases & Migrations
backend/*.db
backend/*.sqlite
backend/prisma/.env


# =========================================================================
# 3. GLOBAL INFRASTRUCTURE & ROOT FILES
# =========================================================================
# Root-level env file (for Docker Compose variables)
.env
.env.local

# Log files
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# OS & System-generated files
.DS_Store
Thumbs.db

# IDEs, Editors & Tooling
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
